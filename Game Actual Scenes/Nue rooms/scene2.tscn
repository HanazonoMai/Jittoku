[sub_resource type="GDScript" id="GDScript_xmnp2"]
script/source = "extends Area2D

@onready var nue : Node2D = $\"../TheUndefined\"
@onready var nuePoint = $\"../nuePoint\"
@onready var nuePoint2 = $\"../nuePoint2\"
@onready var player = $\"../playerOverworld\"

func _on_body_entered(body: Node2D) -> void:
	if not (body is PlayerOverworld):
		return
	
	set_deferred(\"monitoring\", false)
	
	
	player.process_mode = Node.PROCESS_MODE_DISABLED
	var tween = create_tween()
	tween.tween_property(nue, \"global_position\", nuePoint.global_position, 0.5).set_ease(Tween.EASE_OUT)
	await tween.finished
	nue.get_node(\"Growl\").process_mode = Node.PROCESS_MODE_ALWAYS
	nue.get_node(\"Growl\").play()
	
	$\"../CutsceneStarter\".start()
	
	player.process_mode = Node.PROCESS_MODE_INHERIT
	
	nue.get_node(\"Snarl\").process_mode = Node.PROCESS_MODE_ALWAYS
	nue.get_node(\"Snarl\").play()
	var tween2 = create_tween()
	tween2.tween_property(nue, \"global_position\", nuePoint2.global_position, 4).set_ease(Tween.EASE_OUT)
	
	
"

