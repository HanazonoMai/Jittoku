[sub_resource type="GDScript" id="GDScript_xmnp2"]
script/source = "extends Marker2D



func ending(player : Node2D):
	print(\"End\")
	player.set_process(false)
	player.set_process_input(false)
	player.set_physics_process(false)
	var tween = create_tween()
	tween.tween_property(get_parent(), \"modulate\", Color.TRANSPARENT, 2.0)
	tween.parallel().tween_property(player.get_node(\"CanvasLayer/ProgressBar\"), \"modulate\", Color.TRANSPARENT, 2.0)
	tween.parallel().tween_property($\"../CanvasModulate\", \"color\", Color.WHITE, 2.0)
	await tween.finished
	var tween2 = create_tween()
	tween2.tween_property($\"../creditsLayer/credits\", \"modulate\", Color.WHITE, 5.0)
	
"

