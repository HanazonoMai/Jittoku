[sub_resource type="GDScript" id="GDScript_t5h4u"]
script/source = "extends CanvasLayer

const boxes = preload(\"res://sceneTransitionBoxes.tres\")
const teeth = preload(\"res://sceneTransitionTeeth.tres\")

@onready var animation = $AnimationPlayer
@onready var transition = $Transition

func exit():
	transition.material = boxes
	animation.play(&\"exit\")

func enter():
	transition.material = boxes
	animation.play(&\"enter\")

func teethClose():
	transition.material = teeth
	animation.play(&\"exit\")

func teethOpen():
	transition.material = teeth
	animation.play(&\"enter\")
"

